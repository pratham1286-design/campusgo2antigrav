# CampusGo Environment Configuration

# Required in any deployment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app refuses to start with a known placeholder or a key under 32 characters.
SECRET_KEY=

# Where the SQLite file lives (default: backend/campusgo.db)
DATABASE_PATH=

# Public URL used in SOS tracking links, e.g. https://campusgo.example.com
PUBLIC_BASE_URL=

# Number of reverse proxies in front of the app (1 on Render). 0 when run directly.
TRUST_PROXY_HOPS=0

# Demo data: 1 creates the demo personas on an EMPTY database at startup.
SEED_DEMO_DATA=0

# 1 = simulated top-ups (fake money) for demos. Always off when real Razorpay keys are set.
PAYMENTS_DEMO_MODE=0

# 1 = demo-only "Advance Simulation" button that fakes vehicle movement and skips the GPS
# checks for starting/completing trips. Keep 0 for real use: drivers are paid only after their
# own phone has reported a position at the drop-off.
DEMO_SIMULATE_MOVEMENT=0

# Campus time offset from UTC in minutes (India = 330), used for carpool departure times
LOCAL_UTC_OFFSET_MINUTES=330

# UPI merchant VPA shown on the QR code
CAMPUSGO_UPI_VPA=campusgo.lpu@okhdfcbank

# Razorpay live/test credentials (card payments are disabled when unset and demo mode is off)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Enables /api/admin/payments/* for approving UPI top-ups after checking the bank
# statement. Must be 32+ characters; the admin routes return 404 when unset.
ADMIN_API_KEY=

# SMS gateways for SOS texts (without one, contacts are NOT texted and the app says so)
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Campus security helpline shown in the app and in SOS texts
CAMPUS_SECURITY_PHONE="+91 1824 517000"

# 1 = show the SMS login code in the API reply instead of texting it. Local demos only;
# it is ignored whenever an SMS gateway (FAST2SMS_API_KEY / Twilio) is configured.
OTP_DEMO_MODE=0

# Local testing only (python app.py): serve a self-signed HTTPS certificate so a phone on the
# same Wi-Fi can use GPS (needs requirements-dev.txt), and listen on the LAN.
# HTTPS_DEV=1
# HOST=0.0.0.0

# Map services (place search for CityLink destinations, road routes). The defaults are the free
# public OpenStreetMap servers: fine for a demo, but strictly rate limited. For real traffic point
# these at a hosted or self-hosted Nominatim / OSRM, and give GEOCODER_CONTACT an email or URL
# (the public servers require requests to identify the app).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEOCODER_CONTACT=you@example.com
