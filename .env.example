# CampusGo settings. Copy to .env for local runs (python backend/app.py reads it; it is git-ignored).
# On a host, set these as environment variables instead.

# Required in production (gunicorn refuses to start without it). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be 32+ characters. Local `python app.py` runs without it use a random key per start.
SECRET_KEY=

# Public address of the app, e.g. https://campusgo.example.com (used in SOS trip links).
PUBLIC_BASE_URL=

# Number of reverse proxies in front of the app (1 on Render) so rate limits see real client IPs.
TRUST_PROXY_HOPS=0

# --- Database and shared state ---------------------------------------------------------------
# With both set, gunicorn runs several workers and you can run several instances behind a load
# balancer. Without them: SQLite (DATABASE_PATH, default backend/campusgo.db) and one worker.
#   DATABASE_URL=postgresql://user:password@host:5432/campusgo
#   REDIS_URL=redis://host:6379/0
DATABASE_URL=
REDIS_URL=
DATABASE_PATH=

# Workers per instance (default 2 x CPU cores + 1, max 9), threads per worker and database
# connections per worker. Keep WEB_CONCURRENCY x DB_POOL_SIZE x instances under the database's
# connection limit.
WEB_CONCURRENCY=
GUNICORN_THREADS=8
DB_POOL_SIZE=10

# --- SMS: sign-in codes and SOS texts (fill in ONE provider) ---------------------------------
# Without one, nobody can sign in (except REVIEW_LOGIN_PHONE) and SOS alerts text no one.
# Fast2SMS: fast2sms.com > Dev API > API key
FAST2SMS_API_KEY=
# or Twilio: console.twilio.com > Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App Store and Play reviewers can't receive your SMS. This one 10-digit Indian number signs in
# with the fixed 6-digit code below instead of a texted one. Use a number you own; leave both
# empty to turn it off.
REVIEW_LOGIN_PHONE=
REVIEW_LOGIN_CODE=

# --- Payments ----------------------------------------------------------------------------------
# Razorpay (Dashboard > Account & Settings > API Keys): rzp_test_... keys for fake money while
# testing, rzp_live_... keys for real money. Without them the card/UPI checkout is hidden.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret typed in when adding the webhook https://your-app/api/payments/razorpay/webhook
# (Razorpay Dashboard > Account & Settings > Webhooks, event: payment.captured). Credits a
# top-up even if the payer closes the app before the payment finishes.
RAZORPAY_WEBHOOK_SECRET=

# Optional direct UPI QR top-ups, paid into this UPI ID and credited only after an admin checks
# the bank statement (see README). Leave empty to offer Razorpay only.
CAMPUSGO_UPI_VPA=

# Enables /api/admin/* (UPI approvals, driver payouts, faculty approval, SOS list, earnings).
# Must be 32+ characters; the admin routes return 404 when unset.
ADMIN_API_KEY=

# --- Play Store app (Trusted Web Activity) -----------------------------------------------------
# Served at /.well-known/assetlinks.json so the Android app opens without a browser bar.
# Package name you chose, and the SHA-256 signing-key fingerprint(s) from Play Console >
# Setup > App signing (comma-separated).
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# --- Campus ------------------------------------------------------------------------------------
# Campus security helpline shown in the app and in SOS texts
CAMPUS_SECURITY_PHONE="+91 1824 517000"
# Campus time offset from UTC in minutes (India = 330), used for rush hours and carpool times
LOCAL_UTC_OFFSET_MINUTES=330

# --- Maps --------------------------------------------------------------------------------------
# Place search and road routes. The defaults are the free public OpenStreetMap servers: fine
# for testing, but strictly rate limited. For real traffic point these at a hosted or
# self-hosted Nominatim / OSRM, and give GEOCODER_CONTACT an email or URL (the public servers
# require requests to identify the app).
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OSRM_URL=https://router.project-osrm.org
# GEOCODER_CONTACT=you@example.com
# At most this many calls to a map service run at once per worker (the rest fail fast).
# MAP_UPSTREAM_CONCURRENCY=3

# Map tiles. The public OpenStreetMap tile servers forbid heavy use; for real traffic use a
# provider, e.g. TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# with TILE_ATTRIBUTION="&copy; MapTiler &copy; OpenStreetMap contributors"
# TILE_URL=
# TILE_ATTRIBUTION=

# --- Local development only --------------------------------------------------------------------
# python app.py: serve a self-signed HTTPS certificate so a phone on the same Wi-Fi can use GPS
# (needs requirements-dev.txt), and listen on the LAN.
# HTTPS_DEV=1
# HOST=0.0.0.0
